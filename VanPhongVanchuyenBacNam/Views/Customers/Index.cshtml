@model IEnumerable<VanPhongVanchuyenBacNam.Models.Customer>

@{
    ViewData["Title"] = "Khách gửi quen";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Khách gửi quen</h1>
    <a asp-action="Create" class="btn btn-primary">+ Thêm khách hàng</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-5 col-lg-4">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Tìm theo tên hoặc SĐT..." aria-label="Tìm khách hàng" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Chưa có khách hàng nào. Bạn cũng có thể tích &quot;Lưu người gửi vào danh sách khách quen&quot;
        khi tạo vận đơn để thêm nhanh.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tên khách hàng</th>
                    <th>Số điện thoại</th>
                    <th>Địa chỉ</th>
                    <th>Ghi chú</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td class="fw-semibold">@customer.Name</td>
                        <td><a href="tel:@customer.Phone" class="text-decoration-none">@customer.Phone</a></td>
                        <td>@customer.Address</td>
                        <td>@customer.Note</td>
                        <td class="text-end">
                            <a asp-controller="Shipments" asp-action="Create" asp-route-customerId="@customer.Id"
                               class="btn btn-sm btn-outline-success">Tạo vận đơn</a>
                            <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Tổng cộng: @Model.Count() khách hàng</p>
}
