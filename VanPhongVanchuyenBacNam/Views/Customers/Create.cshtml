@model VanPhongVanchuyenBacNam.Models.Customer

@{
    ViewData["Title"] = "Thêm khách hàng";
}

<h1 class="h3">Thêm khách gửi quen</h1>
<hr />

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Create">
            <partial name="_FormFields" />
            <button type="submit" class="btn btn-primary">Lưu khách hàng</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
