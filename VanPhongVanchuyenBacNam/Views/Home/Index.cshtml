@model VanPhongVanchuyenBacNam.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Tổng quan hôm nay</h1>
    <div>
        <a asp-controller="Shipments" asp-action="Create" class="btn btn-primary">+ Tạo vận đơn</a>
        <a asp-controller="TransportCompanies" asp-action="Index" class="btn btn-outline-secondary">Danh bạ nhà xe</a>
    </div>
</div>

@* Quick lookup jumps straight to the shipment list with the search applied. *@
<form method="get" asp-controller="Shipments" asp-action="Index" class="row g-2 mb-4">
    <div class="col-sm-6 col-lg-4">
        <input type="text" name="searchTerm" class="form-control"
               placeholder="Tra cứu: mã vận đơn, tên hoặc SĐT..." aria-label="Tra cứu vận đơn" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tra cứu</button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.TodayCount</div>
                <div>Đơn nhận hôm nay</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-4 fw-bold">@Model.TodayShippingFee.ToVnd()</div>
                <div class="text-muted">Tổng cước hôm nay</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-4 fw-bold text-danger">@Model.TodayCod.ToVnd()</div>
                <div class="text-muted">Tổng COD hôm nay</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold text-success">@Model.DeliveredTodayCount</div>
                <div class="text-muted">Giao thành công hôm nay</div>
            </div>
        </div>
    </div>
</div>

<h2 class="h5">Theo trạng thái</h2>
<div class="row g-3 mb-4">
    @foreach (ShipmentStatus status in Enum.GetValues<ShipmentStatus>())
    {
        var count = Model.StatusCounts.GetValueOrDefault(status);
        <div class="col-6 col-lg-3">
            <a asp-controller="Shipments" asp-action="Index" asp-route-status="@status"
               class="card text-decoration-none h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <partial name="_StatusBadge" model="status" />
                    <span class="fs-4 fw-bold">@count</span>
                </div>
            </a>
        </div>
    }
</div>
@if (Model.UnpaidCount > 0)
{
    <div class="alert alert-warning py-2">
        Có <strong>@Model.UnpaidCount</strong> vận đơn chưa thu cước.
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">Vận đơn mới nhất</h2>
    <a asp-controller="Shipments" asp-action="Index">Xem tất cả &raquo;</a>
</div>
@if (!Model.RecentShipments.Any())
{
    <div class="alert alert-info">
        Chưa có vận đơn nào.
        <a asp-controller="Shipments" asp-action="Create" class="alert-link">Tạo vận đơn đầu tiên</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã vận đơn</th>
                    <th>Người nhận</th>
                    <th>Tỉnh nhận</th>
                    <th>Nhà xe</th>
                    <th class="text-end">COD</th>
                    <th>Trạng thái</th>
                    <th>Ngày gửi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shipment in Model.RecentShipments)
                {
                    <tr>
                        <td>
                            <a asp-controller="Shipments" asp-action="Details" asp-route-id="@shipment.Id"
                               class="font-monospace fw-semibold text-decoration-none">@shipment.TrackingCode</a>
                        </td>
                        <td>@shipment.RecipientName</td>
                        <td>@shipment.RecipientProvince</td>
                        <td>@shipment.TransportCompany?.Name</td>
                        <td class="text-end">
                            @(shipment.CODAmount > 0 ? shipment.CODAmount.ToVnd() : "—")
                        </td>
                        <td><partial name="_StatusBadge" model="shipment.Status" /></td>
                        <td>@shipment.CreatedDate.ToString("dd/MM HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
