@{
    ViewData["Title"] = "Trang chủ";
}

<div class="text-center py-4">
    <h1 class="display-5 fw-bold">Văn phòng Vận chuyển Bắc Nam</h1>
    <p class="lead text-muted">Hệ thống quản trị nhận gửi hàng hóa &amp; bưu kiện nội địa</p>
</div>

<div class="row justify-content-center g-3">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h2 class="h5 card-title">&#128214; Danh bạ nhà xe</h2>
                <p class="card-text text-muted">Tra cứu nhà xe theo tỉnh/thành để liên hệ gửi hàng.</p>
                <a asp-controller="TransportCompanies" asp-action="Index" class="btn btn-primary">Mở danh bạ</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <h2 class="h5 card-title">&#128230; Vận đơn</h2>
                <p class="card-text text-muted">Tạo vận đơn và in nhãn dán kiện hàng.</p>
                <button type="button" class="btn btn-outline-secondary" disabled>Sắp có (Phase 2)</button>
            </div>
        </div>
    </div>
</div>
