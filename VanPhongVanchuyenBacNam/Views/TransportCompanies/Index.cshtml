@model IEnumerable<VanPhongVanchuyenBacNam.Models.TransportCompany>

@{
    ViewData["Title"] = "Danh bạ nhà xe";
    var provinces = (List<string>)ViewBag.Provinces;
    var selectedProvince = (string?)ViewBag.SelectedProvince;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Danh bạ nhà xe</h1>
    <a asp-action="Create" class="btn btn-primary">+ Thêm nhà xe</a>
</div>

@* Filter form submits via GET so the filter is bookmarkable/shareable. *@
<form method="get" class="row g-2 mb-3">
    <div class="col-sm-4 col-lg-3">
        <select name="province" class="form-select" aria-label="Lọc theo tỉnh/thành">
            <option value="">— Tất cả tỉnh/thành —</option>
            @foreach (var province in provinces)
            {
                <option value="@province" selected="@(province == selectedProvince)">@province</option>
            }
        </select>
    </div>
    <div class="col-sm-4 col-lg-3">
        <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control"
               placeholder="Tìm theo tên nhà xe..." aria-label="Tìm theo tên nhà xe" />
    </div>
    <div class="col-sm-4 col-lg-3">
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Không tìm thấy nhà xe nào. <a asp-action="Create" class="alert-link">Thêm nhà xe mới</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tên nhà xe</th>
                    <th>Tỉnh/thành</th>
                    <th>Điện thoại</th>
                    <th>Người liên hệ</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var company in Model)
                {
                    <tr>
                        <td class="fw-semibold">@company.Name</td>
                        <td>@company.Province</td>
                        <td>
                            <a href="tel:@company.PhoneNumber" class="text-decoration-none">@company.PhoneNumber</a>
                            @if (!string.IsNullOrEmpty(company.BackupPhone))
                            {
                                <br />
                                <small class="text-muted">@company.BackupPhone</small>
                            }
                        </td>
                        <td>@company.ContactPerson</td>
                        <td>
                            @if (company.IsActive)
                            {
                                <span class="badge bg-success">Đang hợp tác</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng hợp tác</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@company.Id" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@company.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@company.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Tổng cộng: @Model.Count() nhà xe</p>
}
